      "src": "https://mmilabel-1258344707.cos.ap-guangzhou.myqcloud.com/upload/unpack/hiccupli/20260401/20260127_00004328_awpj_23_spk0/20260127_00004328_awpj_23_30.wav",
      "selectedIndexes": [

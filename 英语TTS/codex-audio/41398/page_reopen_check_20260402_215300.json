      "selectedIndexes": [
        -1,
        1,
        1,
        0,
        1
      ],
      "text": "确实不是特别靠谱啊，这上面还写着撕毁不退换，你写这有什么用呢？"
    },
    {
      "index": 6,
      "filename": "20260127_00004330_atpj_269_68.wav",

# Docker Compose project name (change for multi-instance)
COMPOSE_PROJECT_NAME=asr-worker-1

# Host paths (relative to project root)
HOST_MODELS_DIR=./models
HOST_WORK_AUDIO_DIR=./_work_audio
HOST_WORK_CONTEXT_DIR=./_work_context
HOST_THIRD_PARTY_DIR=./third_party

# Container internal paths (usually no need to change)
PUTONGHUAASR_BASE=/app
PUTONGHUAASR_QWEN3_ASR_MODEL=/app/models/Qwen3-ASR
PUTONGHUAASR_MODEL=/app/models/Qwen3-ASR
PUTONGHUAASR_QWEN3_ASR_DEVICE=cpu
PUTONGHUAASR_QWEN3_ASR_LOCAL_FILES_ONLY=1
PUTONGHUAASR_FIRERED_REPO=/app/third_party/FireRedASR
PUTONGHUAASR_FIRERED_MODEL=/app/models/FireRedASR-AED-L
PUTONGHUAASR_WORK_AUDIO=/app/_work_audio
PUTONGHUAASR_CDP_PORT=9222
PUTONGHUAASR_CDP_ENDPOINT=http://browser:9222

# noVNC port exposed to host
NOVNC_PORT=6080

# VNC password (empty = no password)
VNC_PASSWORD=

# Resource limits
AGENT_MEM_LIMIT=4g
BROWSER_MEM_LIMIT=2g

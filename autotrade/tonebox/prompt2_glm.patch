+async def test_schedule_lesson_multiple_availabilities(client: AsyncClient):
+    teacher = await make_teacher(client, "t_avail8")
+    student = await register_user(client, "s_avail8", "s_avail8@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"], "Saxophone")
+
+    monday = datetime.date(2026, 6, 8)
+    await make_availability(client, teacher["api_key"], teacher["id"], monday.weekday(), "08:00", "10:00")
+    await make_availability(client, teacher["api_key"], teacher["id"], monday.weekday(), "14:00", "17:00")
+
+    resp_morning = await schedule_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"], instrument["id"],
+        str(monday), "09:00:00", 60,

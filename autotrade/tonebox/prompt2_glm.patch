+from __future__ import annotations
+
+import datetime
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, name: str = "Piano") -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": name,
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "is_active": True,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_availability(client: AsyncClient, api_key: str, teacher_id: str, weekday: int, start_time: str, end_time: str, is_active: bool = True) -> dict:
+    resp = await client.post(
+        "/availability",
+        json={
+            "teacher_id": teacher_id,
+            "weekday": weekday,
+            "start_time": start_time,
+            "end_time": end_time,
+            "is_active": is_active,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def schedule_lesson(client: AsyncClient, api_key: str, teacher_id: str, student_id: str, instrument_id: str, lesson_date: str, start_time: str, duration_minutes: int = 60) -> dict:
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": lesson_date,
+            "start_time": start_time,
+            "duration_minutes": duration_minutes,
+        },
+        headers=api_key_header(api_key),
+    )
+    return resp
+
+
+async def test_schedule_lesson_within_availability(client: AsyncClient):
+    teacher = await make_teacher(client, "t_avail1")
+    student = await register_user(client, "s_avail1", "s_avail1@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"], "Guitar")
+
+    monday = datetime.date(2026, 6, 8)
+    await make_availability(client, teacher["api_key"], teacher["id"], monday.weekday(), "08:00", "12:00")
+
+    resp = await schedule_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"], instrument["id"],
+        str(monday), "09:00:00", 60,
+    )
+    assert resp.status_code == 201, resp.text
+    data = resp.json()
+    assert data["teacher_id"] == teacher["id"]
+    assert data["status"] == "scheduled"
+
+
+async def test_schedule_lesson_no_availability(client: AsyncClient):
+    teacher = await make_teacher(client, "t_avail2")
+    student = await register_user(client, "s_avail2", "s_avail2@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"], "Violin")
+
+    tuesday = datetime.date(2026, 6, 9)
+    resp = await schedule_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"], instrument["id"],
+        str(tuesday), "10:00:00", 60,
+    )
+    assert resp.status_code == 400
+    assert resp.json()["detail"] == "Teacher is not available at this time"

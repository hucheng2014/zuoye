+    resp_afternoon = await schedule_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"], instrument["id"],
+        str(monday), "15:00:00", 60,
+    )
+    assert resp_afternoon.status_code == 201, resp_afternoon.text

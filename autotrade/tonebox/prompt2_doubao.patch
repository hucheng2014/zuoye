@@ -0,0 +1,85 @@
+import asyncio
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import datetime
+from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine
+from sqlalchemy.orm import sessionmaker
+
+from core.db import Base
+from music_models.music_models import User
+from lesson_schedule.teacher_availability import TeacherAvailability
+from lesson_schedule.lesson_booking import check_teacher_availability
+
+
+async def verify():
+    # Create an in-memory SQLite database for testing
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:", echo=False)
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    
+    async_session = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
+    
+    async with async_session() as session:
+        # Create a test user
+        teacher = User(
+            id="test-teacher-id",
+            username="test-teacher",
+            email="test@test.com",
+            password_hash="test",
+            api_key="test-key",
+            role="teacher",
+            is_active=True
+        )
+        session.add(teacher)
+        await session.commit()
+        await session.refresh(teacher)
+        
+        # Create an availability
+        avail = TeacherAvailability(
+            teacher_id=teacher.id,
+            weekday=0,
+            start_time="09:00",
+            end_time="18:00",
+            is_active=True
+        )
+        session.add(avail)
+        await session.commit()
+        
+        # Test case 1: Lesson inside availability
+        lesson_date = datetime.date(2026, 6, 9)  # This is a Monday (weekday 0)
+        start_time = datetime.time(10, 0)
+        duration = 60
+        
+        is_available = await check_teacher_availability(
+            session, teacher.id, lesson_date, start_time, duration
+        )
+        print(f"Test 1 (inside availability): {is_available} (expected: True)")
+        
+        # Test case 2: Lesson outside availability
+        start_time = datetime.time(19, 0)
+        is_available = await check_teacher_availability(
+            session, teacher.id, lesson_date, start_time, duration
+        )
+        print(f"Test 2 (outside availability): {is_available} (expected: False)")
+        
+        # Test case 3: Different weekday
+        lesson_date = datetime.date(2026, 6, 10)  # Tuesday (weekday 1)
+        start_time = datetime.time(10, 0)
+        is_available = await check_teacher_availability(
+            session, teacher.id, lesson_date, start_time, duration
+        )
+        print(f"Test 3 (different weekday): {is_available} (expected: False)")
+        
+        # Clean up
+        await session.delete(avail)
+        await session.delete(teacher)
+        await session.commit()
+    
+    await engine.dispose()
+
+
+if __name__ == "__main__":
+    asyncio.run(verify())

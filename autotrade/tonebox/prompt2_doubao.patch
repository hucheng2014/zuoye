+async def check_teacher_availability(
+    db: AsyncSession,
+    teacher_id: str,
+    lesson_date: datetime.date,
+    start_time: datetime.time,
+    duration_minutes: int,
+) -> bool:
+    weekday = lesson_date.weekday()
+    
+    result = await db.execute(
+        select(TeacherAvailability).where(
+            and_(
+                TeacherAvailability.teacher_id == teacher_id,
+                TeacherAvailability.weekday == weekday,
+                TeacherAvailability.is_active == True,
+            )
+        )
+    )
+    availabilities = result.scalars().all()
+    
+    if not availabilities:
+        return False
+    
+    lesson_start = datetime.datetime.combine(datetime.date.min, start_time)
+    lesson_end = lesson_start + datetime.timedelta(minutes=duration_minutes)
+    
+    for avail in availabilities:
+        avail_start = datetime.datetime.strptime(avail.start_time, "%H:%M").time()
+        avail_end = datetime.datetime.strptime(avail.end_time, "%H:%M").time()
+        avail_start_dt = datetime.datetime.combine(datetime.date.min, avail_start)
+        avail_end_dt = datetime.datetime.combine(datetime.date.min, avail_end)
+        
+        if lesson_start >= avail_start_dt and lesson_end <= avail_end_dt:
+            return True
+    
+    return False
+

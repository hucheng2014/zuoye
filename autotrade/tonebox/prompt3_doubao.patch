+++ b/tests/test_prompt3.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+from datetime import date, time
+
+from tests.conftest import api_key_header, register_user
+
+
+async def test_create_lesson_qualified_teacher(client: AsyncClient):
+    # 创建教师用户
+    teacher = await register_user(client, "teacher1", "teacher1@test.com", "pass", "teacher")
+    # 创建学生用户
+    student = await register_user(client, "student1", "student1@test.com", "pass", "student")
+    
+    # 创建乐器，指定教师
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["Beginner"],
+            "teacher_id": teacher["id"],
+            "duration_minutes": 60,
+            "price_per_session": 50.0,
+            "is_active": True,
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 201
+    instrument = resp.json()
+    
+    # 尝试创建课程（应该成功）
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": date.today().isoformat(),
+            "start_time": time(10, 0).isoformat(),
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 201
+    lesson = resp.json()
+    assert lesson["teacher_id"] == teacher["id"]
+    assert lesson["instrument_id"] == instrument["id"]
+
+
+async def test_create_lesson_unqualified_teacher(client: AsyncClient):
+    # 创建教师1
+    teacher1 = await register_user(client, "teacher2", "teacher2@test.com", "pass", "teacher")
+    # 创建教师2
+    teacher2 = await register_user(client, "teacher3", "teacher3@test.com", "pass", "teacher")
+    # 创建学生
+    student = await register_user(client, "student2", "student2@test.com", "pass", "student")
+    
+    # 创建乐器，指定教师1
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Violin",
+            "category": "strings",
+            "lesson_type": "private",
+            "levels": ["Intermediate"],
+            "teacher_id": teacher1["id"],
+            "duration_minutes": 60,
+            "price_per_session": 60.0,
+            "is_active": True,
+        },
+        headers=api_key_header(teacher1["api_key"]),
+    )
+    assert resp.status_code == 201
+    instrument = resp.json()
+    
+    # 尝试让教师2创建课程（应该失败）
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher2["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": date.today().isoformat(),
+            "start_time": time(14, 0).isoformat(),
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(teacher2["api_key"]),
+    )
+    assert resp.status_code == 400
+    assert "Teacher is not qualified to teach this instrument" in resp.json()["detail"]

@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+import datetime
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+async def make_instrument(client: AsyncClient, api_key: str, teacher_id: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "teacher_id": teacher_id,
+            "duration_minutes": 60,
+            "price_per_session": 50.0
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+async def make_lesson(client: AsyncClient, api_key: str, teacher_id: str, student_id: str, instrument_id: str, lesson_date: str, start_time: str) -> dict:
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": lesson_date,
+            "start_time": start_time,
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+async def make_invoice(client: AsyncClient, api_key: str, lesson_id: str, student_id: str, amount: float) -> dict:
+    resp = await client.post(
+        "/invoices",
+        json={
+            "lesson_id": lesson_id,
+            "student_id": student_id,
+            "amount": amount
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+async def test_cancel_unpaid_lesson_gt_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t1")
+    student = await make_student(client, "s1")
+    inst = await make_instrument(client, teacher["api_key"], teacher["id"])
+
+    # Greater than 24h
+    dt = datetime.datetime.now() + datetime.timedelta(days=2)
+    lesson = await make_lesson(client, teacher["api_key"], teacher["id"], student["id"], inst["id"], dt.strftime("%Y-%m-%d"), dt.strftime("%H:%M:%S"))
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+
+    # Cancel lesson
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    # Check invoice
+    inv_resp = await client.get(f"/invoices/{invoice['id']}", headers=api_key_header(teacher["api_key"]))
+    assert inv_resp.status_code == 200
+    inv_data = inv_resp.json()
+    assert inv_data["status"] == "void"
+    assert inv_data["amount"] == 0.0
+
+async def test_cancel_unpaid_lesson_lt_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t2")
+    student = await make_student(client, "s2")
+    inst = await make_instrument(client, teacher["api_key"], teacher["id"])
+
+    # Less than 24h
+    dt = datetime.datetime.now() + datetime.timedelta(hours=12)
+    lesson = await make_lesson(client, teacher["api_key"], teacher["id"], student["id"], inst["id"], dt.strftime("%Y-%m-%d"), dt.strftime("%H:%M:%S"))
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+
+    # Cancel lesson
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    # Check invoice
+    inv_resp = await client.get(f"/invoices/{invoice['id']}", headers=api_key_header(teacher["api_key"]))
+    assert inv_resp.status_code == 200
+    inv_data = inv_resp.json()
+    assert inv_data["status"] == "unpaid"
+    assert inv_data["amount"] == 50.0
+
+async def test_cancel_paid_lesson_gt_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t3")
+    student = await make_student(client, "s3")

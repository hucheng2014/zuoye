diff --git a/tests/test_prompt4.py b/tests/test_prompt4.py
new file mode 100644
index 0000000..1b55549
--- /dev/null
+++ b/tests/test_prompt4.py
@@ -0,0 +1,151 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+from datetime import date
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_admin(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "admin")
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_recital(
+    client: AsyncClient,
+    api_key: str,
+    title: str = "Spring Recital",
+    max_capacity: int = 50,
+) -> dict:
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": title,
+            "event_date": str(date.today()),
+            "venue": "Main Hall",
+            "organizer_id": "dummy",  # We'll fix this later
+            "max_capacity": max_capacity,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_recital_has_max_capacity(client: AsyncClient):
+    admin = await make_admin(client, "r_admin1")
+    recital = await make_recital(client, admin["api_key"], max_capacity=25)
+    assert recital["max_capacity"] == 25
+
+
+async def test_recital_seat_booking(client: AsyncClient):
+    admin = await make_admin(client, "r_admin2")
+    student = await register_user(client, "r_student1", "r_student1@test.com", "pass", "student")
+    
+    # First, we need to create an organizer properly
+    organizer = await make_teacher(client, "r_organizer1")
+    
+    # Create recital with correct organizer_id
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Test Recital",
+            "event_date": str(date.today()),
+            "venue": "Main Hall",
+            "organizer_id": organizer["id"],
+            "max_capacity": 2,
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    recital = resp.json()
+    
+    # Book first seat
+    resp1 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student["id"]},
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp1.status_code == 201, resp1.text
+    booking1 = resp1.json()
+    assert booking1["recital_id"] == recital["id"]
+    
+    # Book second seat
+    student2 = await register_user(client, "r_student2", "r_student2@test.com", "pass", "student")
+    resp2 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"]),
+    )
+    assert resp2.status_code == 201, resp2.text
+    
+    # Third booking should fail (capacity reached)
+    student3 = await register_user(client, "r_student3", "r_student3@test.com", "pass", "student")
+    resp3 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student3["id"]},
+        headers=api_key_header(student3["api_key"]),
+    )
+    assert resp3.status_code == 409, resp3.text
+    assert resp3.json()["detail"] == "Recital is at full capacity"
+
+
+async def test_list_recital_seats(client: AsyncClient):
+    admin = await make_admin(client, "r_admin3")
+    organizer = await make_teacher(client, "r_organizer2")
+    student1 = await register_user(client, "r_student4", "r_student4@test.com", "pass", "student")
+    student2 = await register_user(client, "r_student5", "r_student5@test.com", "pass", "student")
+    
+    # Create recital 1
+    resp1 = await client.post(
+        "/recitals",
+        json={
+            "title": "Recital 1",
+            "event_date": str(date.today()),
+            "venue": "Main Hall",
+            "organizer_id": organizer["id"],
+            "max_capacity": 10,
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+    recital1 = resp1.json()
+    
+    # Create recital 2
+    resp2 = await client.post(
+        "/recitals",
+        json={
+            "title": "Recital 2",
+            "event_date": str(date.today()),
+            "venue": "Small Hall",
+            "organizer_id": organizer["id"],
+            "max_capacity": 10,
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+    recital2 = resp2.json()
+    
+    # Book seat in recital 1
+    await client.post(
+        f"/recitals/{recital1['id']}/seats",
+        json={"user_id": student1["id"]},
+        headers=api_key_header(student1["api_key"]),
+    )
+    
+    # Book seat in recital 2
+    await client.post(
+        f"/recitals/{recital2['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"]),
+    )
+    
+    # List recital 1 seats, should only have 1
+    list_resp = await client.get(
+        f"/recitals/{recital1['id']}/seats",
+        headers=api_key_header(admin["api_key"]),
+    )
+    assert list_resp.status_code == 200
+    assert len(list_resp.json()) == 1

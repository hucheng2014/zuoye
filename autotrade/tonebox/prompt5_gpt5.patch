diff --git a/tests/test_prompt5.py b/tests/test_prompt5.py
new file mode 100644
index 0000000..ed2a7af
--- /dev/null
+++ b/tests/test_prompt5.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+from datetime import date
+
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_staff(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "staff")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, name: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": name,
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "duration_minutes": 60,
+            "price_per_session": 50.0,
+            "is_active": True,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def create_practice_log(
+    client: AsyncClient,
+    api_key: str,
+    student_id: str,
+    instrument_id: str,
+    duration_minutes: int,
+    self_rating: int,
+) -> dict:
+    resp = await client.post(
+        "/practice-logs",
+        json={
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "practice_date": str(date(2026, 1, 1)),
+            "duration_minutes": duration_minutes,
+            "pieces_practiced": ["Etude No. 1"],
+            "goals_for_next_lesson": "Keep steady tempo",
+            "self_rating": self_rating,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_practice_summary_uses_duration_weighted_average_rating(client: AsyncClient):
+    staff = await make_staff(client, "prompt5_staff1")
+    student = await make_student(client, "prompt5_student1")
+    piano = await make_instrument(client, staff["api_key"], "Prompt 5 Piano")
+
+    await create_practice_log(client, student["api_key"], student["id"], piano["id"], 30, 2)
+    await create_practice_log(client, student["api_key"], student["id"], piano["id"], 90, 5)
+
+    resp = await client.get(
+        f"/practice-logs/stats/summary?student_id={student['id']}",
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_sessions"] == 2
+    assert data["total_minutes"] == 120
+    assert data["average_rating"] == 4.25
+
+
+async def test_practice_summary_returns_zero_rating_when_total_duration_is_zero(client: AsyncClient):
+    staff = await make_staff(client, "prompt5_staff2")
+    student = await make_student(client, "prompt5_student2")
+    violin = await make_instrument(client, staff["api_key"], "Prompt 5 Violin")
+
+    await create_practice_log(client, student["api_key"], student["id"], violin["id"], 0, 1)
+    await create_practice_log(client, student["api_key"], student["id"], violin["id"], 0, 5)
+
+    resp = await client.get(
+        f"/practice-logs/stats/summary?student_id={student['id']}",
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_minutes"] == 0
+    assert data["average_rating"] == 0.0
+
+
+async def test_practice_by_instrument_uses_duration_weighted_average_rating(client: AsyncClient):
+    staff = await make_staff(client, "prompt5_staff3")
+    student = await make_student(client, "prompt5_student3")
+    piano = await make_instrument(client, staff["api_key"], "Prompt 5 Grand Piano")
+    guitar = await make_instrument(client, staff["api_key"], "Prompt 5 Guitar")
+
+    await create_practice_log(client, student["api_key"], student["id"], piano["id"], 15, 2)
+    await create_practice_log(client, student["api_key"], student["id"], piano["id"], 45, 5)
+    await create_practice_log(client, student["api_key"], student["id"], guitar["id"], 20, 4)
+    await create_practice_log(client, student["api_key"], student["id"], guitar["id"], 0, 1)
+
+    resp = await client.get(
+        f"/practice-logs/stats/by-instrument?student_id={student['id']}",
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()["by_instrument"]
+    assert data[piano["id"]]["sessions"] == 2
+    assert data[piano["id"]]["total_minutes"] == 60
+    assert data[piano["id"]]["average_rating"] == 4.25
+    assert data[guitar["id"]]["sessions"] == 2
+    assert data[guitar["id"]]["total_minutes"] == 20
+    assert data[guitar["id"]]["average_rating"] == 4.0

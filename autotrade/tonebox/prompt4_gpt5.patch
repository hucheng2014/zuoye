diff --git a/tests/test_prompt4.py b/tests/test_prompt4.py
new file mode 100644
index 0000000..bc084a1
--- /dev/null
+++ b/tests/test_prompt4.py
@@ -0,0 +1,140 @@
+from __future__ import annotations
+
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_admin(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "admin")
+
+
+async def make_recital(
+    client: AsyncClient,
+    api_key: str,
+    organizer_id: str,
+    title: str = "Spring Recital",
+    max_capacity: int = 50,
+) -> dict:
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": title,
+            "event_date": "2026-08-01",
+            "venue": "Main Hall",
+            "organizer_id": organizer_id,
+            "performers": [],
+            "status": "planning",
+            "registration_deadline": "2026-07-25",
+            "admission_fee": 15.0,
+            "max_capacity": max_capacity,
+            "notes": "Evening recital",
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def book_seat(client: AsyncClient, recital_id: str, api_key: str, user_id: str) -> dict:
+    resp = await client.post(
+        f"/recitals/{recital_id}/seats",
+        json={"user_id": user_id, "notes": "Front row"},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_create_recital_supports_max_capacity(client: AsyncClient):
+    teacher = await make_teacher(client, "prompt4_teacher1")
+
+    recital = await make_recital(
+        client,
+        teacher["api_key"],
+        teacher["id"],
+        title="Capacity Showcase",
+        max_capacity=80,
+    )
+
+    assert recital["max_capacity"] == 80
+
+    resp = await client.get(
+        f"/recitals/{recital['id']}",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+    assert resp.json()["max_capacity"] == 80
+
+
+async def test_recital_booking_rejects_when_full(client: AsyncClient):
+    admin = await make_admin(client, "prompt4_admin1")
+    student1 = await register_user(client, "prompt4_student1", "prompt4_student1@test.com", "pass", "student")
+    student2 = await register_user(client, "prompt4_student2", "prompt4_student2@test.com", "pass", "student")
+    student3 = await register_user(client, "prompt4_student3", "prompt4_student3@test.com", "pass", "student")
+
+    recital = await make_recital(
+        client,
+        admin["api_key"],
+        admin["id"],
+        title="Limited Seats Recital",
+        max_capacity=2,
+    )
+
+    booking1 = await book_seat(client, recital["id"], student1["api_key"], student1["id"])
+
+    confirm_resp = await client.post(
+        f"/bookings/{booking1['id']}/confirm",
+        headers=api_key_header(admin["api_key"]),
+    )
+    assert confirm_resp.status_code == 200
+    assert confirm_resp.json()["status"] == "confirmed"
+
+    booking2 = await book_seat(client, recital["id"], student2["api_key"], student2["id"])
+    assert booking2["status"] == "pending"
+
+    resp = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student3["id"], "notes": "Overflow"},
+        headers=api_key_header(student3["api_key"]),
+    )
+    assert resp.status_code == 409
+    assert resp.json()["detail"] == "Recital is at full capacity"
+
+
+async def test_list_recital_seats_filters_by_recital(client: AsyncClient):
+    teacher = await make_teacher(client, "prompt4_teacher2")
+    student = await register_user(client, "prompt4_student4", "prompt4_student4@test.com", "pass", "student")
+
+    recital1 = await make_recital(
+        client,
+        teacher["api_key"],
+        teacher["id"],
+        title="Morning Recital",
+        max_capacity=5,
+    )
+    recital2 = await make_recital(
+        client,
+        teacher["api_key"],
+        teacher["id"],
+        title="Evening Recital",
+        max_capacity=5,
+    )
+
+    booking1 = await book_seat(client, recital1["id"], student["api_key"], student["id"])
+    booking2 = await book_seat(client, recital2["id"], student["api_key"], student["id"])
+
+    resp = await client.get(
+        f"/recitals/{recital1['id']}/seats",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    data = resp.json()
+    assert len(data) == 1
+    assert data[0]["id"] == booking1["id"]
+    assert data[0]["id"] != booking2["id"]

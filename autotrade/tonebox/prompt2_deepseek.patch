+from __future__ import annotations
+
+import datetime
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, name: str = "Piano") -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": name,
+            "category": "keyboard",
+            "lesson_type": "private",
+            "duration_minutes": 60,
+            "price_per_session": 50.0,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def set_availability(
+    client: AsyncClient,
+    api_key: str,
+    teacher_id: str,
+    weekday: int,
+    start_time: str,
+    end_time: str,
+    is_active: bool = True,
+) -> dict:
+    resp = await client.post(
+        "/availability",
+        json={
+            "teacher_id": teacher_id,
+            "weekday": weekday,
+            "start_time": start_time,
+            "end_time": end_time,
+            "is_active": is_active,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_schedule_lesson_within_availability(client: AsyncClient):
+    teacher = await make_teacher(client, "t_avail_1")
+    student = await make_student(client, "s_avail_1")
+    instrument = await make_instrument(client, teacher["api_key"], "Guitar")
+
+    lesson_date = datetime.date(2026, 6, 8)
+    weekday = lesson_date.weekday()
+
+    await set_availability(
+        client, teacher["api_key"], teacher["id"],
+        weekday=weekday, start_time="08:00", end_time="18:00",
+    )
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": str(lesson_date),
+            "start_time": "10:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    data = resp.json()
+    assert data["teacher_id"] == teacher["id"]
+    assert data["lesson_date"] == str(lesson_date)
+
+

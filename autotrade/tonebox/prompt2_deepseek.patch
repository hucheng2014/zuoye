+    teacher = await make_teacher(client, "t_avail_2")
+    student = await make_student(client, "s_avail_2")
+    instrument = await make_instrument(client, teacher["api_key"], "Violin")
+
+    lesson_date = datetime.date(2026, 6, 8)
+    weekday = lesson_date.weekday()
+    different_weekday = (weekday + 1) % 7
+
+    await set_availability(
+        client, teacher["api_key"], teacher["id"],
+        weekday=different_weekday, start_time="08:00", end_time="18:00",
+    )
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": str(lesson_date),
+            "start_time": "10:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 400
+    assert resp.json()["detail"] == "Teacher is not available at this time"

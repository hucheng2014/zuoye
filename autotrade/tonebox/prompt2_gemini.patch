diff --git a/tests/test_prompt2.py b/tests/test_prompt2.py
new file mode 100644
index 0000000..5a4be30
--- /dev/null
+++ b/tests/test_prompt2.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_instrument(client: AsyncClient, api_key: str, name: str = "Guitar") -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={"instrument_name": name, "category": "strings", "is_active": True},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_teacher_availability(client: AsyncClient, api_key: str, teacher_id: str, weekday: int, start_time: str, end_time: str) -> dict:
+    resp = await client.post(
+        "/availability",
+        json={"teacher_id": teacher_id, "weekday": weekday, "start_time": start_time, "end_time": end_time, "is_active": True},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_schedule_lesson_with_availability(client: AsyncClient):
+    teacher = await register_user(client, "teacher1", "teacher1@test.com", "pass", "teacher")
+    student = await register_user(client, "student1", "student1@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"])
+
+    # set availability for weekday 0 (Monday)
+    # 2024-01-01 is Monday
+    await make_teacher_availability(
+        client, teacher["api_key"], teacher["id"], 0, "09:00:00", "12:00:00"
+    )
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2024-01-01",
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 201, resp.text
+
+
+async def test_schedule_lesson_no_availability(client: AsyncClient):
+    teacher = await register_user(client, "teacher2", "teacher2@test.com", "pass", "teacher")
+    student = await register_user(client, "student2", "student2@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"])
+
+    # No availability set
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2024-01-01", # Monday
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 400
+    assert "Teacher is not available at this time" in resp.text
+
+
+async def test_schedule_lesson_outside_availability(client: AsyncClient):
+    teacher = await register_user(client, "teacher3", "teacher3@test.com", "pass", "teacher")
+    student = await register_user(client, "student3", "student3@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"])
+
+    # set availability 09:00-10:00
+    await make_teacher_availability(
+        client, teacher["api_key"], teacher["id"], 0, "09:00:00", "10:00:00"
+    )
+
+    # try booking 09:30-10:30 (outside by 30 mins)
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2024-01-01",
+            "start_time": "09:30:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 400
+    assert "Teacher is not available at this time" in resp.text
+
+
+async def test_schedule_lesson_wrong_weekday(client: AsyncClient):
+    teacher = await register_user(client, "teacher4", "teacher4@test.com", "pass", "teacher")
+    student = await register_user(client, "student4", "student4@test.com", "pass", "student")
+    instrument = await make_instrument(client, teacher["api_key"])
+
+    # set availability for Tuesday (1)
+    await make_teacher_availability(
+        client, teacher["api_key"], teacher["id"], 1, "09:00:00", "12:00:00"
+    )
+
+    # try booking Monday (0)
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2024-01-01", # Monday
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 400
+    assert "Teacher is not available at this time" in resp.text

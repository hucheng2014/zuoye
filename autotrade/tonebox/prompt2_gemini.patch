+async def check_teacher_availability(
+    db: AsyncSession,
+    teacher_id: str,
+    lesson_date: datetime.date,
+    start_time: datetime.time,
+    duration_minutes: int,
+) -> bool:
+    weekday = lesson_date.weekday()
+    start_dt = datetime.datetime.combine(lesson_date, start_time)
+    end_dt = start_dt + datetime.timedelta(minutes=duration_minutes)
+
+    result = await db.execute(
+        select(TeacherAvailability).where(
+            and_(
+                TeacherAvailability.teacher_id == teacher_id,
+                TeacherAvailability.weekday == weekday,
+                TeacherAvailability.is_active == True,
+            )
+        )
+    )
+    availabilities = result.scalars().all()
+
+    for avail in availabilities:
+        try:
+            avail_start = datetime.time.fromisoformat(avail.start_time)
+            avail_end = datetime.time.fromisoformat(avail.end_time)
+        except ValueError:
+            continue
+            
+        avail_start_dt = datetime.datetime.combine(lesson_date, avail_start)
+        avail_end_dt = datetime.datetime.combine(lesson_date, avail_end)
+
+        if start_dt >= avail_start_dt and end_dt <= avail_end_dt:
+            return True
+
+    return False
+

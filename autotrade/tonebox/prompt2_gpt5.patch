+async def check_teacher_availability(
+    db: AsyncSession,
+    teacher_id: str,
+    lesson_date: datetime.date,
+    start_time: datetime.time,
+    duration_minutes: int,
+) -> bool:
+    lesson_start = datetime.datetime.combine(lesson_date, start_time)
+    lesson_end = lesson_start + datetime.timedelta(minutes=duration_minutes)
+
+    if lesson_end.date() != lesson_date:
+        return False
+
+    result = await db.execute(
+        select(TeacherAvailability).where(
+            and_(
+                TeacherAvailability.teacher_id == teacher_id,
+                TeacherAvailability.weekday == lesson_date.weekday(),
+                TeacherAvailability.is_active == True,
+            )
+        )
+    )
+    availabilities = result.scalars().all()
+
+    for availability in availabilities:
+        try:
+            availability_start = datetime.datetime.combine(
+                lesson_date,
+                datetime.time.fromisoformat(availability.start_time),
+            )
+            availability_end = datetime.datetime.combine(
+                lesson_date,
+                datetime.time.fromisoformat(availability.end_time),
+            )
+        except ValueError:
+            continue
+
+        if availability_end <= availability_start:
+            continue
+        if availability_start <= lesson_start and lesson_end <= availability_end:
+            return True
+
+    return False
+

diff --git a/tests/test_prompt6.py b/tests/test_prompt6.py
new file mode 100644
index 0000000..3faf830
--- /dev/null
+++ b/tests/test_prompt6.py
@@ -0,0 +1,244 @@
+from __future__ import annotations
+
+import datetime
+from datetime import timezone
+
+import pytest
+from httpx import AsyncClient
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from core.db import get_db
+from lesson_schedule.lesson_billing import Invoice
+from music_models.music_models import OldLesson, LessonStatus
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, teacher_id: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "teacher_id": teacher_id,
+            "price_per_session": 50.0,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_lesson(client: AsyncClient, api_key: str, teacher_id: str, student_id: str, instrument_id: str, lesson_date: str, start_time: str) -> dict:
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": lesson_date,
+            "start_time": start_time,
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_invoice(client: AsyncClient, api_key: str, lesson_id: str, student_id: str, amount: float) -> dict:
+    resp = await client.post(
+        "/invoices",
+        json={
+            "lesson_id": lesson_id,
+            "student_id": student_id,
+            "amount": amount,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def pay_invoice(client: AsyncClient, api_key: str, invoice_id: int) -> dict:
+    resp = await client.patch(
+        f"/invoices/{invoice_id}/pay",
+        json={"paid": True},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+def future_date(days: int = 2) -> str:
+    d = datetime.date.today() + datetime.timedelta(days=days)
+    return d.isoformat()
+
+
+def past_date(days: int = 1) -> str:
+    d = datetime.date.today() - datetime.timedelta(days=days)
+    return d.isoformat()
+
+
+async def test_cancel_unpaid_invoice_24h_or_more(client: AsyncClient):
+    teacher = await make_teacher(client, "t_cancel_24h")
+    student = await make_student(client, "s_cancel_24h")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+    lesson = await make_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"],
+        instrument["id"], future_date(days=2), "10:00"
+    )
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+    assert invoice["status"] == "unpaid"
+    assert invoice["amount"] == 100.0
+
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+    assert resp.json()["status"] == "cancelled"
+
+    inv_resp = await client.get(
+        f"/invoices/{invoice['id']}",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    updated_invoice = inv_resp.json()
+    assert updated_invoice["status"] == "void"
+    assert updated_invoice["amount"] == 0.0
+
+
+async def test_cancel_unpaid_invoice_less_than_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t_cancel_lt24h")
+    student = await make_student(client, "s_cancel_lt24h")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+    lesson = await make_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"],
+        instrument["id"], future_date(days=0), "10:00"
+    )
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+    assert invoice["status"] == "unpaid"
+    assert invoice["amount"] == 100.0
+
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    inv_resp = await client.get(
+        f"/invoices/{invoice['id']}",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    updated_invoice = inv_resp.json()
+    assert updated_invoice["status"] == "unpaid"
+    assert updated_invoice["amount"] == 50.0
+
+
+async def test_cancel_paid_invoice_24h_or_more(client: AsyncClient):
+    teacher = await make_teacher(client, "t_paid_24h")
+    student = await make_student(client, "s_paid_24h")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+    lesson = await make_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"],
+        instrument["id"], future_date(days=2), "10:00"
+    )
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+    await pay_invoice(client, teacher["api_key"], invoice["id"])
+
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    inv_resp = await client.get(
+        f"/invoices/{invoice['id']}",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    updated_invoice = inv_resp.json()
+    assert updated_invoice["status"] == "refund_pending"
+    assert "Refund amount: 100.0" in updated_invoice["refund_notes"]
+
+
+async def test_cancel_paid_invoice_less_than_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t_paid_lt24h")
+    student = await make_student(client, "s_paid_lt24h")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+    lesson = await make_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"],
+        instrument["id"], future_date(days=0), "10:00"
+    )
+    invoice = await make_invoice(client, teacher["api_key"], lesson["id"], student["id"], 100.0)
+    await pay_invoice(client, teacher["api_key"], invoice["id"])
+
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+
+    inv_resp = await client.get(
+        f"/invoices/{invoice['id']}",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    updated_invoice = inv_resp.json()
+    assert updated_invoice["status"] == "refund_pending"
+    assert "Refund amount: 50.0" in updated_invoice["refund_notes"]
+
+
+async def test_cancel_lesson_without_invoice(client: AsyncClient):
+    teacher = await make_teacher(client, "t_no_inv")
+    student = await make_student(client, "s_no_inv")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+    lesson = await make_lesson(
+        client, teacher["api_key"], teacher["id"], student["id"],
+        instrument["id"], future_date(days=2), "10:00"
+    )
+
+    resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+    assert resp.json()["status"] == "cancelled"
+
+
+async def test_non_cancel_status_does_not_affect_invoice(client: AsyncClient):
+    teacher = await make_teacher(client, "t_no_cancel")
+    student = await make_student(client, "s_no_cancel")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])

+++ b/tests/test_prompt3.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+import datetime
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(
+    client: AsyncClient, api_key: str, instrument_name: str = "Piano", teacher_id: str = None
+) -> dict:
+    payload = {
+        "instrument_name": instrument_name,
+        "category": "keyboard",
+        "lesson_type": "private",
+        "levels": ["beginner", "intermediate"],
+        "teacher_id": teacher_id,
+        "duration_minutes": 60,
+        "price_per_session": 50.0,
+        "is_active": True,
+    }
+    resp = await client.post(
+        "/instruments",
+        json=payload,
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_create_lesson_with_qualified_teacher(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_qualified")
+    student = await make_student(client, "student_1")
+    instrument = await make_instrument(client, teacher["api_key"], "Piano", teacher["id"])
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-07-01",
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    data = resp.json()
+    assert data["teacher_id"] == teacher["id"]
+    assert data["instrument_id"] == instrument["id"]
+
+
+async def test_create_lesson_with_unqualified_teacher(client: AsyncClient):
+    teacher1 = await make_teacher(client, "teacher_1")
+    teacher2 = await make_teacher(client, "teacher_2")
+    student = await make_student(client, "student_2")
+
+    instrument = await make_instrument(client, teacher1["api_key"], "Violin", teacher1["id"])
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher2["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-07-01",
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(teacher2["api_key"]),
+    )
+    assert resp.status_code == 400, resp.text
+    assert resp.json()["detail"] == "Teacher is not qualified to teach this instrument"
+
+
+async def test_create_lesson_with_instrument_no_teacher(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_no_teacher")
+    student = await make_student(client, "student_3")
+
+    instrument = await make_instrument(client, teacher["api_key"], "Guitar", teacher_id=None)
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-07-01",
+            "start_time": "14:00:00",
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 400, resp.text
+    assert resp.json()["detail"] == "Teacher is not qualified to teach this instrument"

diff --git a/tests/test_prompt3.py b/tests/test_prompt3.py
new file mode 100644
index 0000000..be052c5
--- /dev/null
+++ b/tests/test_prompt3.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_admin(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "admin")
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(
+    client: AsyncClient,
+    api_key: str,
+    teacher_id: str,
+    instrument_name: str = "Piano",
+) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": instrument_name,
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "teacher_id": teacher_id,
+            "duration_minutes": 60,
+            "price_per_session": 80.0,
+            "is_active": True,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_schedule_lesson_rejects_unqualified_teacher(client: AsyncClient):
+    admin = await make_admin(client, "prompt3_admin")
+    qualified_teacher = await make_teacher(client, "prompt3_teacher_qualified")
+    unqualified_teacher = await make_teacher(client, "prompt3_teacher_unqualified")
+    student = await make_student(client, "prompt3_student")
+    instrument = await make_instrument(client, admin["api_key"], qualified_teacher["id"])
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": unqualified_teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-06-08",
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+
+    assert resp.status_code == 400
+    assert resp.json()["detail"] == "Teacher is not qualified to teach this instrument"

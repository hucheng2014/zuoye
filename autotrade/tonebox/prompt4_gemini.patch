diff --git a/tests/test_prompt4.py b/tests/test_prompt4.py
new file mode 100644
index 0000000..9c90693
--- /dev/null
+++ b/tests/test_prompt4.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+async def test_recital_capacity_limit(client: AsyncClient):
+    # Register teacher to create recital
+    teacher = await make_teacher(client, "teacher1")
+    
+    # Create recital with max_capacity = 2
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Spring Recital",
+            "event_date": "2024-05-01",
+            "venue": "Main Hall",
+            "organizer_id": teacher["id"],
+            "max_capacity": 2
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 201, resp.text
+    recital = resp.json()
+    assert recital["max_capacity"] == 2
+    
+    # Register students
+    student1 = await register_user(client, "student1", "student1@test.com", "pass", "student")
+    student2 = await register_user(client, "student2", "student2@test.com", "pass", "student")
+    student3 = await register_user(client, "student3", "student3@test.com", "pass", "student")
+    
+    # Book 1st seat
+    resp = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student1["id"]},
+        headers=api_key_header(student1["api_key"])
+    )
+    assert resp.status_code == 201, resp.text
+    
+    # Book 2nd seat
+    resp = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"])
+    )
+    assert resp.status_code == 201, resp.text
+    
+    # Book 3rd seat - should fail with 409
+    resp = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student3["id"]},
+        headers=api_key_header(student3["api_key"])
+    )
+    assert resp.status_code == 409
+    assert resp.json()["detail"] == "Recital is at full capacity"
+
+async def test_list_recital_seats_filters_by_recital(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher2")
+    
+    # Create recital 1
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Recital 1",
+            "event_date": "2024-06-01",
+            "venue": "Hall A",
+            "organizer_id": teacher["id"],
+            "max_capacity": 10
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    recital1 = resp.json()
+    
+    # Create recital 2
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Recital 2",
+            "event_date": "2024-06-02",
+            "venue": "Hall B",
+            "organizer_id": teacher["id"],
+            "max_capacity": 10
+        },
+        headers=api_key_header(teacher["api_key"])
+    )
+    recital2 = resp.json()
+    
+    student1 = await register_user(client, "student4", "student4@test.com", "pass", "student")
+    student2 = await register_user(client, "student5", "student5@test.com", "pass", "student")
+    
+    # Book seat for recital 1
+    await client.post(
+        f"/recitals/{recital1['id']}/seats",
+        json={"user_id": student1["id"]},
+        headers=api_key_header(student1["api_key"])
+    )
+    
+    # Book seat for recital 2
+    await client.post(
+        f"/recitals/{recital2['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"])
+    )
+    
+    # List seats for recital 1
+    resp = await client.get(
+        f"/recitals/{recital1['id']}/seats",
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 200
+    seats1 = resp.json()
+    assert len(seats1) == 1
+    assert seats1[0]["user_id"] == student1["id"]
+    
+    # List seats for recital 2
+    resp = await client.get(
+        f"/recitals/{recital2['id']}/seats",
+        headers=api_key_header(teacher["api_key"])
+    )
+    assert resp.status_code == 200
+    seats2 = resp.json()
+    assert len(seats2) == 1
+    assert seats2[0]["user_id"] == student2["id"]

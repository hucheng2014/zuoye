+def calculate_refund_ratio(lesson: OldLesson, current_time: Optional[datetime.datetime] = None) -> float:
+    lesson_start = datetime.datetime.combine(lesson.lesson_date, lesson.start_time)
+    reference_time = current_time or datetime.datetime.now()
+    if lesson_start - reference_time >= datetime.timedelta(hours=24):
+        return 1.0
+    return 0.5
+
+
+async def apply_cancellation_policy(db: AsyncSession, lesson: OldLesson) -> None:
+    result = await db.execute(select(Invoice).where(Invoice.lesson_id == lesson.id))
+    invoices = list(result.scalars().all())
+    if not invoices:
+        return
+
+    refund_ratio = calculate_refund_ratio(lesson)
+
+    for invoice in invoices:
+        if invoice.status == "unpaid":
+            if refund_ratio == 1.0:
+                invoice.amount = 0.0
+                invoice.status = "void"
+            else:
+                invoice.amount = round(invoice.amount * 0.5, 2)
+            continue
+
+        if invoice.status == "paid":
+            refund_amount = round(invoice.amount * refund_ratio, 2)
+            refund_percentage = int(refund_ratio * 100)
+            invoice.status = "refund_pending"
+            invoice.refund_notes = (
+                f"Refund amount pending: {refund_amount:.2f} ({refund_percentage}% of invoice amount)"
+            )
+
+

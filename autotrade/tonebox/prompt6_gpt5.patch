diff --git a/tests/test_prompt6.py b/tests/test_prompt6.py
new file mode 100644
index 0000000..2895bd2
--- /dev/null
+++ b/tests/test_prompt6.py
@@ -0,0 +1,138 @@
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_staff(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "staff")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, teacher_id: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Policy Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "teacher_id": teacher_id,
+            "duration_minutes": 60,
+            "price_per_session": 80.0,
+            "is_active": True,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_scheduled_lesson(
+    client: AsyncClient,
+    api_key: str,
+    teacher_id: str,
+    student_id: str,
+    instrument_id: str,
+    start_at: datetime,
+) -> dict:
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": start_at.date().isoformat(),
+            "start_time": start_at.time().replace(microsecond=0).isoformat(),
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_invoice(
+    client: AsyncClient,
+    api_key: str,
+    lesson_id: str,
+    student_id: str,
+    amount: float = 80.0,
+) -> dict:
+    resp = await client.post(
+        "/invoices",
+        json={"lesson_id": lesson_id, "student_id": student_id, "amount": amount},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+@pytest.mark.parametrize(
+    ("invoice_state", "hours_until_lesson", "expected_status", "expected_amount", "expected_refund"),
+    [
+        ("unpaid", 30, "void", 0.0, None),
+        ("unpaid", 2, "unpaid", 40.0, None),
+        ("paid", 30, "refund_pending", 80.0, "80.00"),
+        ("paid", 2, "refund_pending", 80.0, "40.00"),
+    ],
+)
+async def test_lesson_cancellation_invoice_policy(
+    client: AsyncClient,
+    invoice_state: str,
+    hours_until_lesson: int,
+    expected_status: str,
+    expected_amount: float,
+    expected_refund: str | None,
+):
+    staff = await make_staff(client, f"policy_staff_{invoice_state}_{hours_until_lesson}")
+    student = await make_student(client, f"policy_student_{invoice_state}_{hours_until_lesson}")
+    instrument = await make_instrument(client, staff["api_key"], staff["id"])
+    lesson_start = datetime.now() + timedelta(hours=hours_until_lesson)
+    lesson = await make_scheduled_lesson(
+        client,
+        staff["api_key"],
+        staff["id"],
+        student["id"],
+        instrument["id"],
+        lesson_start,
+    )
+    invoice = await make_invoice(client, staff["api_key"], lesson["id"], student["id"])
+
+    if invoice_state == "paid":
+        pay_resp = await client.patch(
+            f"/invoices/{invoice['id']}/pay",
+            headers=api_key_header(student["api_key"]),
+        )
+        assert pay_resp.status_code == 200, pay_resp.text
+
+    cancel_resp = await client.patch(
+        f"/lessons/{lesson['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(staff["api_key"]),
+    )
+    assert cancel_resp.status_code == 200, cancel_resp.text
+    assert cancel_resp.json()["status"] == "cancelled"
+
+    invoice_resp = await client.get(
+        f"/invoices/{invoice['id']}",
+        headers=api_key_header(staff["api_key"]),
+    )
+    assert invoice_resp.status_code == 200, invoice_resp.text
+
+    invoice_data = invoice_resp.json()
+    assert invoice_data["status"] == expected_status
+    assert invoice_data["amount"] == expected_amount
+
+    if expected_refund is None:
+        assert invoice_data["refund_notes"] is None
+    else:
+        assert expected_refund in invoice_data["refund_notes"]

@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+import datetime
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_recital(client: AsyncClient, api_key: str, **kwargs) -> dict:
+    defaults = {
+        "title": "Test Recital",
+        "event_date": (datetime.date.today() + datetime.timedelta(days=30)).isoformat(),
+        "venue": "Main Hall",
+        "organizer_id": "test-organizer",
+        "status": "confirmed",
+        "admission_fee": 10.0,
+    }
+    defaults.update(kwargs)
+    resp = await client.post(
+        "/recitals",
+        json=defaults,
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def book_recital_seat(
+    client: AsyncClient,
+    api_key: str,
+    recital_id: str,
+    user_id: str,
+) -> dict:
+    resp = await client.post(
+        f"/recitals/{recital_id}/seats",
+        json={"user_id": user_id},
+        headers=api_key_header(api_key),
+    )
+    return resp
+
+
+async def test_booking_fails_when_deadline_passed(client: AsyncClient):
+    student = await register_user(client, "deadline_stud1", "deadline_stud1@test.com", "pass", "student")
+    admin = await register_user(client, "deadline_admin1", "deadline_admin1@test.com", "pass", "admin")
+
+    past_date = (datetime.date.today() - datetime.timedelta(days=1)).isoformat()
+    recital = await make_recital(client, admin["api_key"], registration_deadline=past_date)
+
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 400
+    assert resp.json()["detail"] == "Registration deadline has passed"
+
+
+async def test_booking_succeeds_when_deadline_not_passed(client: AsyncClient):
+    student = await register_user(client, "deadline_stud2", "deadline_stud2@test.com", "pass", "student")
+    admin = await register_user(client, "deadline_admin2", "deadline_admin2@test.com", "pass", "admin")
+
+    future_date = (datetime.date.today() + datetime.timedelta(days=30)).isoformat()
+    recital = await make_recital(client, admin["api_key"], registration_deadline=future_date)
+
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 201
+    assert resp.json()["booking_type"] == "recital"
+
+
+async def test_booking_succeeds_when_no_deadline_set(client: AsyncClient):
+    student = await register_user(client, "deadline_stud3", "deadline_stud3@test.com", "pass", "student")
+    admin = await register_user(client, "deadline_admin3", "deadline_admin3@test.com", "pass", "admin")
+
+    recital = await make_recital(client, admin["api_key"])
+
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 201
+    assert resp.json()["booking_type"] == "recital"
+
+
+async def test_booking_succeeds_on_same_day_as_deadline(client: AsyncClient):
+    student = await register_user(client, "deadline_stud4", "deadline_stud4@test.com", "pass", "student")
+    admin = await register_user(client, "deadline_admin4", "deadline_admin4@test.com", "pass", "admin")
+
+    today = datetime.date.today().isoformat()
+    recital = await make_recital(client, admin["api_key"], registration_deadline=today)
+
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 201

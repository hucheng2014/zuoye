+++ b/tests/test_prompt5.py
@@ -0,0 +1,130 @@
+from __future__ import annotations
+
+import datetime
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+async def make_instrument(client: AsyncClient, api_key: str, name: str, category: str = "keyboard") -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": name,
+            "category": category,
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+async def create_practice_log(
+    client: AsyncClient,
+    api_key: str,
+    student_id: str,
+    instrument_id: str,
+    duration: int,
+    rating: int,
+    date_str: str = "2024-01-01"
+) -> dict:
+    resp = await client.post(
+        "/practice-logs",
+        json={
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "practice_date": date_str,
+            "duration_minutes": duration,
+            "self_rating": rating
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+@pytest.mark.asyncio
+async def test_practice_stats_weighted_average(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher1")
+    student = await register_user(client, "student1", "student1@test.com", "pass", "student")
+
+    inst1 = await make_instrument(client, teacher["api_key"], "Piano", "keyboard")
+    inst2 = await make_instrument(client, teacher["api_key"], "Violin", "strings")
+
+    # Create logs
+    # Piano:
+    # 60 mins, rating 5 -> weight 60*5 = 300
+    # 30 mins, rating 3 -> weight 30*3 = 90
+    # Piano total time: 90. Piano total rating score: 390. Piano avg: 390 / 90 = 4.33
+    await create_practice_log(client, student["api_key"], student["id"], inst1["id"], 60, 5, "2024-01-01")
+    await create_practice_log(client, student["api_key"], student["id"], inst1["id"], 30, 3, "2024-01-02")
+
+    # Violin:
+    # 10 mins, rating 2 -> weight 10*2 = 20
+    # Violin total time: 10. Violin total rating score: 20. Violin avg: 20 / 10 = 2.0
+    await create_practice_log(client, student["api_key"], student["id"], inst2["id"], 10, 2, "2024-01-03")
+
+    # Overall:
+    # Total time = 90 + 10 = 100
+    # Total score = 390 + 20 = 410
+    # Overall avg = 410 / 100 = 4.10
+
+    # Test summary
+    resp = await client.get(
+        f"/practice-logs/stats/summary?student_id={student['id']}",
+        headers=api_key_header(student["api_key"])
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_minutes"] == 100
+    assert data["average_rating"] == 4.10
+
+    # Test by-instrument
+    resp_by_inst = await client.get(
+        f"/practice-logs/stats/by-instrument?student_id={student['id']}",
+        headers=api_key_header(student["api_key"])
+    )
+    assert resp_by_inst.status_code == 200
+    data_by_inst = resp_by_inst.json()
+    
+    piano_stats = data_by_inst["by_instrument"][inst1["id"]]
+    assert piano_stats["total_minutes"] == 90
+    assert piano_stats["average_rating"] == 4.33
+
+    violin_stats = data_by_inst["by_instrument"][inst2["id"]]
+    assert violin_stats["total_minutes"] == 10
+    assert violin_stats["average_rating"] == 2.0
+
+@pytest.mark.asyncio
+async def test_practice_stats_zero_duration(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher2")
+    student = await register_user(client, "student2", "student2@test.com", "pass", "student")
+
+    inst1 = await make_instrument(client, teacher["api_key"], "Flute", "woodwind")
+
+    # Create log with 0 duration
+    await create_practice_log(client, student["api_key"], student["id"], inst1["id"], 0, 4, "2024-01-01")
+
+    # Test summary
+    resp = await client.get(
+        f"/practice-logs/stats/summary?student_id={student['id']}",
+        headers=api_key_header(student["api_key"])
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_minutes"] == 0
+    assert data["average_rating"] == 0.0
+
+    # Test by-instrument
+    resp_by_inst = await client.get(
+        f"/practice-logs/stats/by-instrument?student_id={student['id']}",
+        headers=api_key_header(student["api_key"])
+    )
+    assert resp_by_inst.status_code == 200
+    data_by_inst = resp_by_inst.json()
+    
+    flute_stats = data_by_inst["by_instrument"][inst1["id"]]
+    assert flute_stats["total_minutes"] == 0
+    assert flute_stats["average_rating"] == 0.0

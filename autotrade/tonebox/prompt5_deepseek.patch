@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+import uuid
+from datetime import date
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user, TestSessionFactory
+from music_models.music_models import Instrument, InstrumentCategory, LessonType, PracticeLog
+
+
+async def _create_instrument(name: str = "Piano", category: str = "keyboard") -> Instrument:
+    async with TestSessionFactory() as session:
+        inst = Instrument(
+            id=str(uuid.uuid4()),
+            instrument_name=name,
+            category=InstrumentCategory(category),
+            lesson_type=LessonType.private,
+        )
+        session.add(inst)
+        await session.commit()
+        await session.refresh(inst)
+        return inst
+
+
+async def _create_log(
+    student_id: str,
+    instrument_id: str,
+    duration_minutes: int,
+    self_rating: int,
+) -> PracticeLog:
+    async with TestSessionFactory() as session:
+        log = PracticeLog(
+            id=str(uuid.uuid4()),
+            student_id=student_id,
+            instrument_id=instrument_id,
+            practice_date=date(2025, 6, 1),
+            duration_minutes=duration_minutes,
+            self_rating=self_rating,
+        )
+        session.add(log)
+        await session.commit()
+        await session.refresh(log)
+        return log
+
+
+async def test_practice_summary_empty(client: AsyncClient):
+    user = await register_user(client, "stats_empty", "stats_empty@test.com", "pass")
+    resp = await client.get(
+        "/practice-logs/stats/summary",
+        headers=api_key_header(user["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_sessions"] == 0
+    assert data["average_rating"] == 0.0
+
+
+async def test_practice_summary_weighted_avg(client: AsyncClient):
+    user = await register_user(client, "stats_wavg", "stats_wavg@test.com", "pass")
+    inst = await _create_instrument("Violin", "strings")
+
+    await _create_log(user["id"], inst.id, 30, 4)
+    await _create_log(user["id"], inst.id, 60, 2)
+    await _create_log(user["id"], inst.id, 10, 5)
+
+    resp = await client.get(
+        "/practice-logs/stats/summary",
+        headers=api_key_header(user["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_sessions"] == 3
+    assert data["total_minutes"] == 100
+    assert data["average_rating"] == 2.9
+
+
+async def test_practice_summary_zero_duration(client: AsyncClient):
+    user = await register_user(client, "stats_zd", "stats_zd@test.com", "pass")
+    inst = await _create_instrument()
+    await _create_log(user["id"], inst.id, 0, 3)
+    await _create_log(user["id"], inst.id, 0, 4)
+
+    resp = await client.get(
+        "/practice-logs/stats/summary",
+        headers=api_key_header(user["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total_sessions"] == 2
+    assert data["total_minutes"] == 0
+    assert data["average_rating"] == 0.0
+
+
+async def test_practice_by_instrument_weighted_avg(client: AsyncClient):
+    user = await register_user(client, "stats_instr", "stats_instr@test.com", "pass")
+    piano = await _create_instrument("Piano", "keyboard")
+    violin = await _create_instrument("Violin", "strings")
+
+    await _create_log(user["id"], piano.id, 60, 5)
+    await _create_log(user["id"], piano.id, 30, 3)
+
+    await _create_log(user["id"], violin.id, 45, 2)
+    await _create_log(user["id"], violin.id, 15, 4)
+
+    resp = await client.get(
+        f"/practice-logs/stats/by-instrument?student_id={user['id']}",
+        headers=api_key_header(user["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["student_id"] == user["id"]
+
+    piano_stats = data["by_instrument"][piano.id]
+    assert piano_stats["sessions"] == 2
+    assert piano_stats["total_minutes"] == 90
+    assert piano_stats["average_rating"] == 4.33
+
+    violin_stats = data["by_instrument"][violin.id]
+    assert violin_stats["sessions"] == 2
+    assert violin_stats["total_minutes"] == 60
+    assert violin_stats["average_rating"] == 2.5
+
+
+async def test_practice_by_instrument_no_logs(client: AsyncClient):
+    user = await register_user(client, "stats_nolog", "stats_nolog@test.com", "pass")
+    resp = await client.get(
+        f"/practice-logs/stats/by-instrument?student_id={user['id']}",
+        headers=api_key_header(user["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["student_id"] == user["id"]
+    assert data["by_instrument"] == {}

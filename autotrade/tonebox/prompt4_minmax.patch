diff --git a/tests/test_prompt4.py b/tests/test_prompt4.py
new file mode 100644
index 0000000..030c6ec
--- /dev/null
+++ b/tests/test_prompt4.py
@@ -0,0 +1,165 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_recital(client: AsyncClient, api_key: str, title: str = "Spring Recital", max_capacity: int = 50) -> dict:
+    from datetime import date, timedelta
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": title,
+            "event_date": (date.today() + timedelta(days=30)).isoformat(),
+            "venue": "Main Hall",
+            "organizer_id": "test-organizer",
+            "performers": [],
+            "status": "confirmed",
+            "admission_fee": 10.0,
+            "max_capacity": max_capacity,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def book_recital_seat(client: AsyncClient, api_key: str, recital_id: str, user_id: str) -> dict:
+    resp = await client.post(
+        f"/recitals/{recital_id}/seats",
+        json={"user_id": user_id},
+        headers=api_key_header(api_key),
+    )
+    return resp
+
+
+async def test_book_recital_seat_success(client: AsyncClient):
+    admin = await register_user(client, "admin_r1", "admin_r1@test.com", "pass", "admin")
+    student = await register_user(client, "student_r1", "student_r1@test.com", "pass", "student")
+
+    recital = await make_recital(client, admin["api_key"], max_capacity=50)
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 201, resp.text
+    assert resp.json()["recital_id"] == recital["id"]
+    assert resp.json()["status"] == "pending"
+
+
+async def test_book_recital_seat_at_full_capacity(client: AsyncClient):
+    admin = await register_user(client, "admin_r2", "admin_r2@test.com", "pass", "admin")
+    student1 = await register_user(client, "student_r2a", "student_r2a@test.com", "pass", "student")
+    student2 = await register_user(client, "student_r2b", "student_r2b@test.com", "pass", "student")
+
+    recital = await make_recital(client, admin["api_key"], max_capacity=1)
+
+    resp1 = await book_recital_seat(client, student1["api_key"], recital["id"], student1["id"])
+    assert resp1.status_code == 201, resp1.text
+
+    resp2 = await book_recital_seat(client, student2["api_key"], recital["id"], student2["id"])
+    assert resp2.status_code == 409, resp2.text
+    assert resp2.json()["detail"] == "Recital is at full capacity"
+
+
+async def test_book_recital_seat_at_exact_capacity(client: AsyncClient):
+    admin = await register_user(client, "admin_r3", "admin_r3@test.com", "pass", "admin")
+    student1 = await register_user(client, "student_r3a", "student_r3a@test.com", "pass", "student")
+    student2 = await register_user(client, "student_r3b", "student_r3b@test.com", "pass", "student")
+    student3 = await register_user(client, "student_r3c", "student_r3c@test.com", "pass", "student")
+
+    recital = await make_recital(client, admin["api_key"], max_capacity=2)
+
+    resp1 = await book_recital_seat(client, student1["api_key"], recital["id"], student1["id"])
+    assert resp1.status_code == 201, resp1.text
+
+    resp2 = await book_recital_seat(client, student2["api_key"], recital["id"], student2["id"])
+    assert resp2.status_code == 201, resp2.text
+
+    resp3 = await book_recital_seat(client, student3["api_key"], recital["id"], student3["id"])
+    assert resp3.status_code == 409, resp3.text
+    assert resp3.json()["detail"] == "Recital is at full capacity"
+
+
+async def test_list_recital_seats_only_returns_bookings_for_that_recital(client: AsyncClient):
+    admin = await register_user(client, "admin_r4", "admin_r4@test.com", "pass", "admin")
+    student1 = await register_user(client, "student_r4a", "student_r4a@test.com", "pass", "student")
+    student2 = await register_user(client, "student_r4b", "student_r4b@test.com", "pass", "student")
+
+    recital1 = await make_recital(client, admin["api_key"], title="Recital One", max_capacity=10)
+    recital2 = await make_recital(client, admin["api_key"], title="Recital Two", max_capacity=10)
+
+    await book_recital_seat(client, student1["api_key"], recital1["id"], student1["id"])
+    await book_recital_seat(client, student2["api_key"], recital2["id"], student2["id"])
+
+    resp1 = await client.get(f"/recitals/{recital1['id']}/seats", headers=api_key_header(admin["api_key"]))
+    assert resp1.status_code == 200
+    seats1 = resp1.json()
+    assert len(seats1) == 1
+    assert seats1[0]["user_id"] == student1["id"]
+
+    resp2 = await client.get(f"/recitals/{recital2['id']}/seats", headers=api_key_header(admin["api_key"]))
+    assert resp2.status_code == 200
+    seats2 = resp2.json()
+    assert len(seats2) == 1
+    assert seats2[0]["user_id"] == student2["id"]
+
+
+async def test_recital_not_found(client: AsyncClient):
+    admin = await register_user(client, "admin_r5", "admin_r5@test.com", "pass", "admin")
+    resp = await client.get("/recitals/nonexistent-id/seats", headers=api_key_header(admin["api_key"]))
+    assert resp.status_code == 404
+
+
+async def test_recital_booking_response_includes_recital_id(client: AsyncClient):
+    admin = await register_user(client, "admin_r6", "admin_r6@test.com", "pass", "admin")
+    student = await register_user(client, "student_r6", "student_r6@test.com", "pass", "student")
+
+    recital = await make_recital(client, admin["api_key"], max_capacity=50)
+    resp = await book_recital_seat(client, student["api_key"], recital["id"], student["id"])
+    assert resp.status_code == 201
+    data = resp.json()
+    assert "recital_id" in data
+    assert data["recital_id"] == recital["id"]
+
+
+async def test_recital_max_capacity_default_is_50(client: AsyncClient):
+    admin = await register_user(client, "admin_r7", "admin_r7@test.com", "pass", "admin")
+
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Default Capacity Recital",
+            "event_date": "2030-12-01",
+            "venue": "Main Hall",
+            "organizer_id": "test-organizer",
+            "performers": [],
+            "status": "confirmed",
+            "admission_fee": 0.0,
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    recital = resp.json()
+    assert recital["max_capacity"] == 50
+
+
+async def test_recital_with_custom_max_capacity(client: AsyncClient):
+    admin = await register_user(client, "admin_r8", "admin_r8@test.com", "pass", "admin")
+
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Small Recital",
+            "event_date": "2030-12-01",
+            "venue": "Room B",
+            "organizer_id": "test-organizer",
+            "performers": [],
+            "status": "confirmed",
+            "admission_fee": 5.0,
+            "max_capacity": 20,
+        },
+        headers=api_key_header(admin["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    recital = resp.json()
+    assert recital["max_capacity"] == 20

@@ -0,0 +1,163 @@
+from __future__ import annotations
+
+import datetime
+import pytest
+from httpx import AsyncClient
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from tests.conftest import api_key_header, register_user, TestSessionFactory
+from lesson_schedule.lesson_booking import get_lesson, update_lesson_status
+from lesson_schedule.lesson_billing import Invoice
+from music_models.music_models import OldLesson, LessonStatus, LessonScheduleType
+
+
+async def make_user(client: AsyncClient, username: str, role: str = "student") -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", role)
+
+
+async def make_instrument(client: AsyncClient, api_key: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "duration_minutes": 60,
+            "price_per_session": 100.0,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_lesson(
+    client: AsyncClient, 
+    api_key: str, 
+    teacher_id: str, 
+    student_id: str, 
+    instrument_id: str,
+    hours_from_now: int = 48
+) -> dict:
+    lesson_date = (datetime.datetime.now() + datetime.timedelta(hours=hours_from_now)).date()
+    start_time = (datetime.datetime.now() + datetime.timedelta(hours=hours_from_now)).time()
+    
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": lesson_date.isoformat(),
+            "start_time": start_time.isoformat(),
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_invoice(client: AsyncClient, api_key: str, lesson_id: str, student_id: str, amount: float = 100.0) -> dict:
+    resp = await client.post(
+        "/invoices",
+        json={
+            "lesson_id": lesson_id,
+            "student_id": student_id,
+            "amount": amount,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def pay_invoice(client: AsyncClient, api_key: str, invoice_id: int) -> dict:
+    resp = await client.patch(
+        f"/invoices/{invoice_id}/pay",
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def cancel_lesson(client: AsyncClient, api_key: str, lesson_id: str) -> dict:
+    resp = await client.patch(
+        f"/lessons/{lesson_id}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def test_cancel_unpaid_lesson_more_than_24h(client: AsyncClient):
+    admin = await make_user(client, "admin1", "admin")
+    teacher = await make_user(client, "teacher1", "teacher")
+    student = await make_user(client, "student1", "student")
+    instrument = await make_instrument(client, admin["api_key"])
+    lesson = await make_lesson(client, admin["api_key"], teacher["id"], student["id"], instrument["id"], hours_from_now=48)
+    invoice = await make_invoice(client, admin["api_key"], lesson["id"], student["id"], 100.0)
+    
+    await cancel_lesson(client, admin["api_key"], lesson["id"])
+    
+    resp = await client.get(f"/invoices/{invoice['id']}", headers=api_key_header(admin["api_key"]))
+    assert resp.status_code == 200
+    updated_invoice = resp.json()
+    assert updated_invoice["status"] == "void"
+    assert updated_invoice["amount"] == 0.0
+
+
+async def test_cancel_unpaid_lesson_less_than_24h(client: AsyncClient):
+    admin = await make_user(client, "admin2", "admin")
+    teacher = await make_user(client, "teacher2", "teacher")
+    student = await make_user(client, "student2", "student")
+    instrument = await make_instrument(client, admin["api_key"])
+    lesson = await make_lesson(client, admin["api_key"], teacher["id"], student["id"], instrument["id"], hours_from_now=12)
+    invoice = await make_invoice(client, admin["api_key"], lesson["id"], student["id"], 100.0)
+    
+    await cancel_lesson(client, admin["api_key"], lesson["id"])
+    
+    resp = await client.get(f"/invoices/{invoice['id']}", headers=api_key_header(admin["api_key"]))
+    assert resp.status_code == 200
+    updated_invoice = resp.json()
+    assert updated_invoice["status"] == "unpaid"
+    assert updated_invoice["amount"] == 50.0
+
+
+async def test_cancel_paid_lesson_more_than_24h(client: AsyncClient):
+    admin = await make_user(client, "admin3", "admin")
+    teacher = await make_user(client, "teacher3", "teacher")
+    student = await make_user(client, "student3", "student")
+    instrument = await make_instrument(client, admin["api_key"])
+    lesson = await make_lesson(client, admin["api_key"], teacher["id"], student["id"], instrument["id"], hours_from_now=48)
+    invoice = await make_invoice(client, admin["api_key"], lesson["id"], student["id"], 100.0)
+    await pay_invoice(client, admin["api_key"], invoice["id"])
+    
+    await cancel_lesson(client, admin["api_key"], lesson["id"])
+    
+    resp = await client.get(f"/invoices/{invoice['id']}", headers=api_key_header(admin["api_key"]))
+    assert resp.status_code == 200
+    updated_invoice = resp.json()
+    assert updated_invoice["status"] == "refund_pending"
+    assert "Refund full amount: 100.0" in updated_invoice["refund_notes"]
+
+
+async def test_cancel_paid_lesson_less_than_24h(client: AsyncClient):
+    admin = await make_user(client, "admin4", "admin")
+    teacher = await make_user(client, "teacher4", "teacher")
+    student = await make_user(client, "student4", "student")
+    instrument = await make_instrument(client, admin["api_key"])
+    lesson = await make_lesson(client, admin["api_key"], teacher["id"], student["id"], instrument["id"], hours_from_now=12)
+    invoice = await make_invoice(client, admin["api_key"], lesson["id"], student["id"], 100.0)

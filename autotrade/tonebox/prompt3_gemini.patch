diff --git a/tests/test_prompt3.py b/tests/test_prompt3.py
new file mode 100644
index 0000000..76d72a6
--- /dev/null
+++ b/tests/test_prompt3.py
@@ -0,0 +1,54 @@
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+async def test_teacher_not_qualified(client: AsyncClient):
+    # 1. Register teacher 1
+    teacher1 = await register_user(client, "teacher1", "teacher1@example.com", "pass", "teacher")
+    
+    # 2. Register teacher 2
+    teacher2 = await register_user(client, "teacher2", "teacher2@example.com", "pass", "teacher")
+    
+    # 3. Register a student
+    student = await register_user(client, "student1", "student1@example.com", "pass", "student")
+
+    # 4. Create an instrument assigned to teacher 1
+    instrument_payload = {
+        "instrument_name": "Piano",
+        "category": "keyboard",
+        "lesson_type": "private",
+        "levels": ["beginner", "intermediate"],
+        "teacher_id": teacher1["id"],
+        "duration_minutes": 60,
+        "price_per_session": 50.0,
+        "is_active": True
+    }
+    resp = await client.post(
+        "/instruments",
+        json=instrument_payload,
+        headers=api_key_header(teacher1["api_key"])
+    )
+    assert resp.status_code == 201
+    instrument = resp.json()
+
+    # 5. Attempt to create a lesson for the instrument using teacher 2
+    lesson_payload = {
+        "teacher_id": teacher2["id"],
+        "student_id": student["id"],
+        "instrument_id": instrument["id"],
+        "lesson_date": "2024-12-01",
+        "start_time": "10:00:00",
+        "duration_minutes": 60,
+        "lesson_type": "regular",
+        "notes": "Test lesson"
+    }
+    resp = await client.post(
+        "/lessons",
+        json=lesson_payload,
+        headers=api_key_header(teacher2["api_key"])
+    )
+
+    # 6. Verify 400 Bad Request
+    assert resp.status_code == 400
+    assert resp.json()["detail"] == "Teacher is not qualified to teach this instrument"

     lesson = await update_lesson_status(
         db, lesson, payload.status, payload.notes, payload.recording_url
     )
+
+    if payload.status == LessonStatus.cancelled:
+        result = await db.execute(select(Invoice).where(Invoice.lesson_id == lesson_id))
+        invoice = result.scalar_one_or_none()
+        if invoice:
+            lesson_dt = datetime.datetime.combine(lesson.lesson_date, lesson.start_time)
+            lesson_dt = lesson_dt.replace(tzinfo=datetime.timezone.utc)
+            now = datetime.datetime.now(datetime.timezone.utc)
+            hours_until_lesson = (lesson_dt - now).total_seconds() / 3600
+
+            if invoice.status == "unpaid":
+                if hours_until_lesson >= 24:
+                    invoice.amount = 0.0
+                    invoice.status = "void"
+                else:
+                    invoice.amount = invoice.amount * 0.5
+            elif invoice.status == "paid":
+                refund_amount = invoice.amount if hours_until_lesson >= 24 else invoice.amount * 0.5
+                invoice.status = "refund_pending"
+                invoice.refund_notes = f"Refund due: {refund_amount:.2f}"
+
+            await db.commit()
+

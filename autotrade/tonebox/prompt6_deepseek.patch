+from __future__ import annotations
+
+import datetime
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, teacher_id: str) -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": "Piano",
+            "category": "keyboard",
+            "lesson_type": "private",
+            "levels": ["beginner"],
+            "teacher_id": teacher_id,
+            "duration_minutes": 60,
+            "price_per_session": 100.0,
+            "is_active": True,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_lesson(
+    client: AsyncClient,
+    api_key: str,
+    teacher_id: str,
+    student_id: str,
+    instrument_id: str,
+    lesson_date: datetime.date,
+    start_time: datetime.time,
+) -> dict:
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher_id,
+            "student_id": student_id,
+            "instrument_id": instrument_id,
+            "lesson_date": lesson_date.isoformat(),
+            "start_time": start_time.strftime("%H:%M:%S"),
+            "duration_minutes": 60,
+            "lesson_type": "regular",
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def make_invoice(
+    client: AsyncClient,
+    api_key: str,
+    lesson_id: str,
+    student_id: str,
+    amount: float = 200.0,
+) -> dict:
+    resp = await client.post(
+        "/invoices",
+        json={
+            "lesson_id": lesson_id,
+            "student_id": student_id,
+            "amount": amount,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def pay_invoice(client: AsyncClient, api_key: str, invoice_id: int) -> dict:
+    resp = await client.patch(
+        f"/invoices/{invoice_id}/pay",
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def cancel_lesson(client: AsyncClient, api_key: str, lesson_id: str) -> dict:
+    resp = await client.patch(
+        f"/lessons/{lesson_id}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def get_invoice(client: AsyncClient, api_key: str, invoice_id: int) -> dict:
+    resp = await client.get(
+        f"/invoices/{invoice_id}",
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def test_cancel_unpaid_invoice_24h_plus(client: AsyncClient):
+    teacher = await make_teacher(client, "t_unpaid_24plus")
+    student = await make_student(client, "s_unpaid_24plus")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+
+    future_date = datetime.date.today() + datetime.timedelta(days=3)
+    lesson = await make_lesson(
+        client,
+        teacher["api_key"],
+        teacher["id"],
+        student["id"],
+        instrument["id"],
+        future_date,
+        datetime.time(10, 0),
+    )
+
+    invoice = await make_invoice(
+        client,
+        teacher["api_key"],
+        lesson["id"],
+        student["id"],
+        amount=200.0,
+    )
+
+    await cancel_lesson(client, teacher["api_key"], lesson["id"])
+
+    updated = await get_invoice(client, teacher["api_key"], invoice["id"])
+    assert updated["status"] == "void"
+    assert updated["amount"] == 0.0
+
+
+async def test_cancel_unpaid_invoice_under_24h(client: AsyncClient):
+    teacher = await make_teacher(client, "t_unpaid_under24")
+    student = await make_student(client, "s_unpaid_under24")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"])
+
+    soon_dt = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=1)
+    lesson = await make_lesson(
+        client,
+        teacher["api_key"],
+        teacher["id"],
+        student["id"],
+        instrument["id"],
+        soon_dt.date(),
+        soon_dt.time(),
+    )
+
+    invoice = await make_invoice(
+        client,
+        teacher["api_key"],
+        lesson["id"],
+        student["id"],
+        amount=200.0,
+    )
+
+    await cancel_lesson(client, teacher["api_key"], lesson["id"])
+
+    updated = await get_invoice(client, teacher["api_key"], invoice["id"])
+    assert updated["status"] == "unpaid"
+    assert updated["amount"] == 100.0
+
+

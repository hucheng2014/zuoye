@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def make_student(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "student")
+
+
+async def make_instrument(client: AsyncClient, api_key: str, teacher_id: str, name: str = "Piano") -> dict:
+    resp = await client.post(
+        "/instruments",
+        json={
+            "instrument_name": name,
+            "category": "keyboard",
+            "teacher_id": teacher_id,
+            "duration_minutes": 60,
+            "price_per_session": 50.0,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_teacher_can_schedule_lesson_for_own_instrument(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_qual1")
+    student = await make_student(client, "student_qual1")
+    instrument = await make_instrument(client, teacher["api_key"], teacher["id"], "Violin")
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-06-10",
+            "start_time": "10:00:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 201, resp.text
+    data = resp.json()
+    assert data["teacher_id"] == teacher["id"]
+    assert data["instrument_id"] == instrument["id"]
+
+
+async def test_teacher_cannot_schedule_lesson_for_other_instrument(client: AsyncClient):
+    teacher1 = await make_teacher(client, "teacher_qual2")
+    teacher2 = await make_teacher(client, "teacher_qual3")
+    student = await make_student(client, "student_qual2")
+    instrument = await make_instrument(client, teacher1["api_key"], teacher1["id"], "Guitar")
+
+    resp = await client.post(
+        "/lessons",
+        json={
+            "teacher_id": teacher2["id"],
+            "student_id": student["id"],
+            "instrument_id": instrument["id"],
+            "lesson_date": "2026-06-10",
+            "start_time": "11:00:00",
+            "duration_minutes": 60,
+        },
+        headers=api_key_header(teacher2["api_key"]),
+    )
+    assert resp.status_code == 400, resp.text
+    assert resp.json()["detail"] == "Teacher is not qualified to teach this instrument"

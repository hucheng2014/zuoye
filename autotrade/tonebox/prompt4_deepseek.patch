diff --git a/tests/test_prompt4.py b/tests/test_prompt4.py
new file mode 100644
index 0000000..51851f9
--- /dev/null
+++ b/tests/test_prompt4.py
@@ -0,0 +1,140 @@
+from __future__ import annotations
+
+import pytest
+from httpx import AsyncClient
+
+from tests.conftest import api_key_header, register_user
+
+
+async def make_teacher(client: AsyncClient, username: str) -> dict:
+    return await register_user(client, username, f"{username}@test.com", "pass", "teacher")
+
+
+async def create_recital(
+    client: AsyncClient,
+    api_key: str,
+    teacher_id: str,
+    max_capacity: int = 50,
+) -> dict:
+    resp = await client.post(
+        "/recitals",
+        json={
+            "title": "Spring Recital",
+            "event_date": "2026-12-15",
+            "venue": "Main Hall",
+            "organizer_id": teacher_id,
+            "max_capacity": max_capacity,
+        },
+        headers=api_key_header(api_key),
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+async def test_create_recital_has_default_max_capacity(client: AsyncClient):
+    teacher = await make_teacher(client, "t1")
+    recital = await create_recital(client, teacher["api_key"], teacher["id"])
+    assert recital["max_capacity"] == 50
+
+
+async def test_create_recital_with_custom_max_capacity(client: AsyncClient):
+    teacher = await make_teacher(client, "t2")
+    recital = await create_recital(client, teacher["api_key"], teacher["id"], max_capacity=30)
+    assert recital["max_capacity"] == 30
+
+
+async def test_book_seat_until_full_capacity(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_full")
+    recital = await create_recital(client, teacher["api_key"], teacher["id"], max_capacity=2)
+
+    student1 = await register_user(client, "s1", "s1@test.com", "pass", "student")
+    student2 = await register_user(client, "s2", "s2@test.com", "pass", "student")
+    student3 = await register_user(client, "s3", "s3@test.com", "pass", "student")
+
+    resp1 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student1["id"]},
+        headers=api_key_header(student1["api_key"]),
+    )
+    assert resp1.status_code == 201
+
+    resp2 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"]),
+    )
+    assert resp2.status_code == 201
+
+    resp3 = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student3["id"]},
+        headers=api_key_header(student3["api_key"]),
+    )
+    assert resp3.status_code == 409
+    assert "full capacity" in resp3.json()["detail"].lower()
+
+
+async def test_list_recital_seats_only_returns_this_recital(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_list")
+    recital1 = await create_recital(client, teacher["api_key"], teacher["id"], max_capacity=5)
+    recital2 = await create_recital(client, teacher["api_key"], teacher["id"], max_capacity=5)
+
+    student1 = await register_user(client, "sl1", "sl1@test.com", "pass", "student")
+    student2 = await register_user(client, "sl2", "sl2@test.com", "pass", "student")
+
+    await client.post(
+        f"/recitals/{recital1['id']}/seats",
+        json={"user_id": student1["id"]},
+        headers=api_key_header(student1["api_key"]),
+    )
+    await client.post(
+        f"/recitals/{recital2['id']}/seats",
+        json={"user_id": student2["id"]},
+        headers=api_key_header(student2["api_key"]),
+    )
+
+    resp = await client.get(
+        f"/recitals/{recital1['id']}/seats",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert resp.status_code == 200
+    data = resp.json()
+    assert len(data) == 1
+    assert data[0]["recital_id"] == recital1["id"]
+
+    resp2 = await client.get(
+        f"/recitals/{recital2['id']}/seats",
+        headers=api_key_header(teacher["api_key"]),
+    )
+    assert len(resp2.json()) == 1
+    assert resp2.json()[0]["recital_id"] == recital2["id"]
+
+
+async def test_cannot_book_cancelled_recital(client: AsyncClient):
+    teacher = await make_teacher(client, "teacher_cancel")
+    recital = await create_recital(client, teacher["api_key"], teacher["id"], max_capacity=10)
+
+    await client.patch(
+        f"/recitals/{recital['id']}/status",
+        json={"status": "cancelled"},
+        headers=api_key_header(teacher["api_key"]),
+    )
+
+    student = await register_user(client, "sc1", "sc1@test.com", "pass", "student")
+    resp = await client.post(
+        f"/recitals/{recital['id']}/seats",
+        json={"user_id": student["id"]},
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp.status_code == 409
+    assert "cancelled" in resp.json()["detail"].lower()
+
+
+async def test_recital_not_found_on_booking(client: AsyncClient):
+    student = await register_user(client, "snf", "snf@test.com", "pass", "student")
+    resp = await client.post(
+        "/recitals/nonexistent-id/seats",
+        json={"user_id": student["id"]},
+        headers=api_key_header(student["api_key"]),
+    )
+    assert resp.status_code == 404
